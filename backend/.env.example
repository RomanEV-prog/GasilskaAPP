# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=gasilapp

# TypeORM
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=ZAMENJAJ_Z_DOLGIM_RANDOM_STRINGOM
# Dostopni žeton je kratkoživ, refresh žeton dolgoživ (rotacija ob /auth/refresh).
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d
# Če ni nastavljen, se izpelje iz JWT_SECRET (priporočeno: lasten random string).
JWT_REFRESH_SECRET=ZAMENJAJ_Z_DRUGIM_DOLGIM_RANDOM_STRINGOM

# File storage (MVP: lokalno; privzeto ./uploads)
# UPLOADS_DIR=C:\pot\do\uploads

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Firebase (za push obvestila)
FIREBASE_PROJECT_ID=gasilapp
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gasilapp.iam.gserviceaccount.com

# Master ključ za izdajo aktivacijskih kod (POST /auth/registration-codes).
# Če ni nastavljen, je izdaja kod izklopljena.
REGISTRATION_KEY=ZAMENJAJ_Z_DOLGIM_RANDOM_STRINGOM

# ─── Računi za naročnine (stran Platforma) ───────────────────────────────
# Podatki izdajatelja se izpišejo na račun. Brez njih portal opozori,
# da račun ni popoln. Davčno potrjevanje (FURS) velja za gotovino —
# plačila po nakazilu vanj ne sodijo.
INVOICE_ISSUER_NAME=Naziv firme
INVOICE_ISSUER_ADDRESS=Ulica in hišna številka
INVOICE_ISSUER_POST=1000 Ljubljana
INVOICE_ISSUER_TAX=12345678
INVOICE_ISSUER_REG=
# Izpolni samo, če si zavezanec za DDV (npr. SI12345678).
INVOICE_ISSUER_VAT_ID=
INVOICE_ISSUER_IBAN=SI56 0000 0000 0000 000
INVOICE_ISSUER_BANK=
INVOICE_ISSUER_EMAIL=racuni@primer.si
INVOICE_ISSUER_PHONE=
INVOICE_ISSUER_WEBSITE=

# 0 = nisi zavezanec za DDV (privzeto besedilo navede 94. člen ZDDV-1).
INVOICE_VAT_RATE=0
INVOICE_FOOTER_NOTE=
# Privzet rok plačila v dneh in privzete cene v EUR (predizpolnijo obrazec).
INVOICE_PAYMENT_DAYS=8
INVOICE_YEARLY_PRICE=0
INVOICE_MONTHLY_PRICE=0
