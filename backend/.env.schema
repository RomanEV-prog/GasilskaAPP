# Varlock shema za backend okolje — validacija tipov in označevanje skrivnosti.
# Preveri (vrednosti so maskirane):  varlock load
# Poženi s skrivnostmi:              varlock run -- npm run start:dev
#
# Ta datoteka NE vsebuje pravih vrednosti — te so v .env (gitignoran).
# Privzeto ne-občutljivo; prave skrivnosti so spodaj označene z @sensitive.
# @defaultSensitive=false @envFlag=NODE_ENV
# ---

# ── Baza ─────────────────────────────────────────────────────────────────────
# @type=string @required
DB_HOST=localhost
# @type=port @required
DB_PORT=5432
# @type=string @required
DB_USER=postgres
# @type=string @required @sensitive
DB_PASS=
# @type=string @required
DB_NAME=gasilapp

# ── TypeORM ──────────────────────────────────────────────────────────────────
# Pozor: v produkciji naj bo false (samodejna sinhronizacija sheme je nevarna).
# @type=boolean
DB_SYNCHRONIZE=false
# @type=boolean
DB_LOGGING=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# @type=string(minLength=32) @required @sensitive
JWT_SECRET=
# @type=string
JWT_ACCESS_EXPIRES=1h
# @type=string
JWT_REFRESH_EXPIRES=30d
# Če ni nastavljen, se izpelje iz JWT_SECRET (priporočeno: lasten random string).
# @type=string(minLength=32) @optional @sensitive
JWT_REFRESH_SECRET=

# ── Shramba datotek (MVP: lokalno) ───────────────────────────────────────────
# @type=string @optional
UPLOADS_DIR=

# ── Aplikacija ───────────────────────────────────────────────────────────────
# @type=port @required
PORT=4000
# @type=enum(development,test,production) @required
NODE_ENV=development
# @type=url @required
FRONTEND_URL=http://localhost:3000

# ── Firebase (push obvestila) ────────────────────────────────────────────────
# @type=string @required
FIREBASE_PROJECT_ID=gasilapp
# Zasebni ključ storitvenega računa — NAJBOLJ občutljiv podatek v projektu.
# @type=string @required @sensitive
FIREBASE_PRIVATE_KEY=
# @type=email @required @sensitive
FIREBASE_CLIENT_EMAIL=

# ── Registracijske kode ──────────────────────────────────────────────────────
# Master ključ za izdajo aktivacijskih kod (POST /auth/registration-codes).
# Če ni nastavljen, je izdaja kod izklopljena.
# @type=string(minLength=32) @optional @sensitive
REGISTRATION_KEY=
