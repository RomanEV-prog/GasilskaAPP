# Caddy streže web portal in preusmerja /api na backend.
# DOMAIN pride iz okolja (docker-compose). HTTPS certifikat je samodejen (Let's Encrypt).
{$DOMAIN} {
	encode gzip

	# ── Varnostni headerji (za vse odgovore) ──────────────────────────────
	header {
		# HTTPS prisilno tudi za prihodnje obiske (1 leto, s poddomenami)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Brskalnik ne ugiba tipov datotek (MIME sniffing off)
		X-Content-Type-Options "nosniff"
		# Aplikacije ni dovoljeno vgraditi v tuj iframe (clickjacking)
		X-Frame-Options "DENY"
		# Referrer le znotraj iste domene
		Referrer-Policy "strict-origin-when-cross-origin"
		# Izklopi občutljive API-je brskalnika, ki jih app ne rabi
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		# CSP: skripte le lastne + gstatic (Firebase SW importScripts);
		# connect vključuje Firebase Installations/FCM za web push.
		# style 'unsafe-inline' rabijo React knjižnice z inline stili.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com https://fcm.googleapis.com https://www.gstatic.com https://*.ingest.de.sentry.io; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Odstrani izdajo strežnika
		-Server
	}

	# API + Swagger → NestJS backend
	handle /api/* {
		reverse_proxy backend:4000
	}

	# Beta prenos Android APK (test pri uporabnikih pred Google Play).
	# Datoteke iz host mape /downloads (glej docker-compose.prod.yml).
	# Stare različice beta strani so imele relativno povezavo, ki je padla na koren.
	redir /gasilapp.apk /beta/gasilapp.apk permanent
	handle_path /beta* {
		root * /downloads
		@apk path *.apk
		header @apk {
			Content-Type application/vnd.android.package-archive
			Content-Disposition "attachment; filename=gasilapp.apk"
			# APK vedno leži na ISTI poti (/beta/gasilapp.apk), zato brskalnik
			# brez tega postreže predpomnjeno staro različico — tester namesti
			# star build in misli, da objava ni delovala. "no-cache" ne pomeni
			# "ne shrani", ampak "pred uporabo vedno preveri": ob nespremenjeni
			# datoteki ETag vrne 304 in 75 MB se NE prenese znova.
			Cache-Control "no-cache"
		}
		# Beta stran se ne sme predpomniti — povezava/verzija se spreminjata.
		@html not path *.apk
		header @html Cache-Control "no-cache"
		file_server
	}

	# React SPA (statika + fallback na index.html za client-side routing)
	handle {
		root * /srv

		# Sredstva imajo zgoščeno vrednost v imenu (index-CbYY9cFt.js), zato je
		# nova različica vedno novo ime — varno jih je predpomniti za leto dni.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Vse ostalo (predvsem index.html) se NE sme predpomniti: kaže na
		# sredstva z novimi imeni. Brez tega brskalnik po objavi obdrži star
		# index.html in s tem STARO aplikacijo — na strežniku je nova, uporabnik
		# pa je ne dobi, dokler ne počisti predpomnilnika. Udarilo 2026-07-29
		# (platformski račun je videl portal društva).
		# "no-cache" ne pomeni "ne shrani", ampak "pred uporabo vedno preveri" —
		# ob nespremenjeni datoteki ETag vrne 304 in prenosa ni.
		@nocache not path /assets/*
		header @nocache Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
